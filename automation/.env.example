# =============================================================================
# .env.example — Modele de variables d'environnement pour automation/
#
# REGLES :
#   1. Copier vers `.env` (JAMAIS committe — ajouter a .gitignore) :
#        cp .env.example .env && chmod 600 .env
#   2. Ne mettre ici que des placeholders ; aucun secret reel, meme annule.
#   3. Les scripts sourcent `.env` automatiquement et REFUSENT de s'executer
#      en mode --apply si une variable requise est absente.
#
# Toutes les donnees du depot sont anonymisees (example.local,
# PUBLIC_IP_REDACTED) ; les identifiants ci-dessous sont fictifs.
# =============================================================================

# --- Provisionnement Proxmox --------------------------------------------------
# Compte admin systeme injecte dans les VM via cloud-init (proxmox-create-vms.sh)
VM_ADMIN_PASSWORD=
# Token API PVE pour le pve-exporter (lecture seule, cf. deploy-exporters.yml)
PVE_TOKEN_ID=            # ex: monitoring@pve!ro-token
PVE_TOKEN=
PVE_SSH_USER=root        # user ssh des nœuds pve01/pve02 (non sensible)

# --- Proxmox Backup Server (pbs-backup-job.sh / restore-drill.sh) ------------
# user@pbs!token — token a scope datastore, jamais le compte root
PBS_USER=
PBS_TOKEN=
PBS_HOST=10.10.50.10     # PBS01 (plan §4) — IP interne, non sensible
PBS_FINGERPRINT=         # empreinte TLS du datastore PBS
PBS_DATASTORE=backup
PBS_STORAGE_NAME=pbs-nas # nom du stockage PBS monte cote PVE

# --- NAS Synology (synology-replication-check.sh) -----------------------------
SYNO_HOST=10.10.50.20    # nas01 (plan §4)
SYNO_PORT=5001
SYNO_TOKEN=              # token API DSM 7 (prioritaire)
SYNO_USER=               # secours : compte lecture seule
SYNO_PASSWORD=
SYNO_CA_BUNDLE=          # CA interne pour verifier le TLS du DSM
REPLICATION_MAX_AGE_HOURS=26

# --- Monitoring / alerting ----------------------------------------------------
ALERTMANAGER_URL=http://10.10.60.12:9093   # mon-alert-01 (plan §4)
GLPI_TOKEN=              # API REST GLPI01 (10.10.80.110) — creation tickets auto
GRAFANA_TOKEN=           # (ex: provisioning d'alerting contact points)

# --- SNMP v3 (monitoring/snmp/snmp-v3.md) --------------------------------------
SNMPV3_USERNAME=
SNMPV3_AUTH_PASSPHRASE=      # SHA-256
SNMPV3_PRIV_PASSPHRASE=      # AES-128

# --- SMTP / notifications email ------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=automation@example.local
SMTP_TO=it-admins@example.local

# --- RADIUS (WiFi 802.1X via DC01/DC02, note : utilise par les configs NAC) ----
RADIUS_SECRET=               # shared secret 802.1X (jamais en dur ailleurs)

# --- PowerShell / AD ------------------------------------------------------------
# windows-dc-promote.ps1 : les DSRM/join passwords se saisissent en
# Read-Host -AsSecureString ; cette variable n'est utile qu'en CI non interactive.
AD_JOIN_USER=EXAMPLE\\ansible-win
AD_JOIN_PASSWORD=
